{
  "name": "@shko.online/pptb-miw",
  "version": "0.1.0",
  "displayName": "Managed Identity Wizard",
  "description": "A PPTB tool to simplify configuring Dataverse Managed Identity for Plugin Assemblies or Plugin Packages.",
  "main": "index.html",
  "author": "Shko Online <sales@shko.online>",
  "contributors": [
